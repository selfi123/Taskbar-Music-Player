<Window x:Class="TaskbarMusicApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbar Music Player" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        Topmost="True" 
        ShowInTaskbar="False"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded">

    <Border Background="#1E1E1E" CornerRadius="12">
        <Grid VerticalAlignment="Center" Margin="10,0">
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /> <!-- App Icon / Title -->
            <ColumnDefinition Width="200" />  <!-- Search Field -->
            <ColumnDefinition Width="Auto" /> <!-- Search Results Dropdown -->
            <ColumnDefinition Width="*" />    <!-- Song Title Info -->
            <ColumnDefinition Width="Auto" /> <!-- Play / Pause Controls -->
        </Grid.ColumnDefinitions>

        <!-- Hidden Audio Player Engine -->
        <MediaElement x:Name="AudioPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" 
                      MediaEnded="AudioPlayer_MediaEnded" MediaFailed="AudioPlayer_MediaFailed" />

        <!-- Logo -->
        <TextBlock Text="🎵" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>

        <!-- Singers Dropdown -->
        <ComboBox x:Name="SingersDropdown" Grid.Column="1" Height="26" Width="190" 
                  Margin="0,0,5,0" Foreground="Black"
                  SelectionChanged="SingersDropdown_SelectionChanged" />

        <!-- Search Results List -->
        <ComboBox x:Name="ResultsDropdown" Grid.Column="2" Width="180" Height="26" Margin="5,0"
                  DisplayMemberPath="Name" SelectionChanged="ResultsDropdown_SelectionChanged" 
                  Foreground="Black" Visibility="Collapsed"/>

        <!-- Currently Playing Song Details -->
        <TextBlock x:Name="TrackInfoText" Grid.Column="3" Text="No song playing" 
                   Foreground="#AAAAAA" VerticalAlignment="Center" Margin="15,0" 
                   TextTrimming="CharacterEllipsis"/>

        <!-- Playback Controls -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PlayPauseBtn" Content="▶" Width="28" Height="26" 
                    Background="#3A3A3A" Foreground="White" BorderThickness="0" 
                    Click="PlayPauseBtn_Click"/>
            <Button x:Name="CloseBtn" Content="✕" Width="24" Height="26" Margin="6,0,0,0"
                    Background="Transparent" Foreground="#888888" BorderThickness="0" 
                    Click="CloseBtn_Click" Cursor="Hand" ToolTip="Close" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
